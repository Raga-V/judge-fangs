# Copy to .env for local runs. Never commit .env.

# --- The model: any OpenAI-compatible chat completions API ---
# Google AI Studio (default). Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=google/gemma-4-31b-it  LLM_API_KEY=sk-or-...
# Self-hosted (vLLM, Ollama, llama.cpp server...): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gemma4:31b  (no key needed on localhost)
LLM_TIMEOUT=240
# Extra max_tokens for models that think before answering (Gemma 4 does)
LLM_THINKING_TOKENS=3000
# Used on the retry when the main model is overloaded (AI Studio sometimes answers 503)
LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it
DEMO_MODE=false

# --- Digging ---
# Optional, lifts GitHub's 60 requests/hour limit. https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=
# Optional, finds the winners announcement automatically. https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Voice: https://elevenlabs.io/app/settings/api-keys ---
ELEVENLABS_API_KEY=
# A deep, severe voice ID from https://elevenlabs.io/app/voice-library (default: a premade deep voice)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2

# --- Tracing (optional). Sentry > Project Settings > Client Keys (DSN) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- CORS: the static site's origin (Render sets this from the Blueprint) ---
WEB_ORIGIN=
EXTRA_ORIGINS=

# --- Spending guards ---
DAILY_REVIEW_CAP=300
DAILY_VOICE_CAP=300
RATE_REVIEWS_PER_10M=6
RATE_BACKTEST_PER_10M=25
RATE_VOICE_PER_10M=12

# --- Web app build (web/.env.local) ---
# VITE_API_BASE=https://fangs-api.onrender.com

# --- Desktop companion (or edit desktop/config.json) ---
# FANGS_API_BASE=https://fangs-api.onrender.com
# FANGS_WEB_BASE=https://fangs-web.onrender.com
